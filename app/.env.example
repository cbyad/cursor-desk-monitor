# Required: copy WorkosCursorSessionToken from cursor.com DevTools → Application → Cookies
CURSOR_SESSION_TOKEN=

# API base URL
CURSOR_API_BASE=https://cursor.com

# How often to fetch and publish usage (e.g. 5 minutes, 10 minutes, 1 hour)
SYNC_INTERVAL=10 minutes

# Transport: log | serial | mqtt
TRANSPORT=log

# Serial transport (only when TRANSPORT=serial)
# macOS: use /dev/cu.* (call-out) for host→device writes, not /dev/tty.*
# SERIAL_PORT=/dev/cu.usbmodem101
# SERIAL_BAUD_RATE=115200
# If Bun serialport write callbacks fail, use: bun run sync:once:serial (Node runtime)
# Close pio device monitor (or any other serial monitor) before syncing — only one process can hold the port.

# Fallback paid hard limit in USD when API returns null for onDemand.limit
# PAID_LIMIT_USD=150

# Log compact JSON payload alongside formatted lines
LOG_PAYLOAD_JSON=true
